# name: test/sql/cpt_online.test
# description: online change detection (FOCuS0): state as a value, backtest, table-driven streaming
# group: [cpt]

require cpt

statement ok
CREATE MACRO u(i, k) AS (abs(sin((i + 1) * 12.9898 + k * 78.233) * 43758.5453) % 1.0) * 0.999998 + 0.000001;

statement ok
CREATE MACRO z(i, k) AS sqrt(-2 * ln(u(i, k))) * cos(2 * pi() * u(i, k + 1));

# level 20, sd 2; up by 3 after 600 points, down by 5 after 1400
statement ok
CREATE TABLE s AS
SELECT list(20 + CASE WHEN i >= 600 THEN 3 ELSE 0 END + CASE WHEN i >= 1400 THEN -5 ELSE 0 END + 2 * z(i, 1)
            ORDER BY i) AS xs
FROM range(2000) t(i);

# --- backtest over a whole series (defaults: threshold 15, baseline learned from 100 points) ----

query II
SELECT list_transform(cpt_online(xs), lambda a: [a.change_at, a.detected_at]),
       list_transform(cpt_online(xs), lambda a: round(a.shift, 1))
FROM s
----
[[599, 614], [1400, 1405]]	[3.1, -6.2]

# --- the state is a value: chained updates over any chunks give the same alarms ----------------

query III
WITH a AS (SELECT xs, cpt_online_update(cpt_online_new(), xs[1:500]) AS r FROM s),
b AS (SELECT xs, a.r AS r1, cpt_online_update(a.r.state, xs[501:1450]) AS r FROM a),
c AS (SELECT r1, b.r AS r2, cpt_online_update(b.r.state, xs[1451:2000]) AS r FROM b)
SELECT list_concat(r1.alarms, r2.alarms, r.alarms) = (SELECT cpt_online(xs) FROM s), r.n, r.training FROM c
----
true	2000	false

# one point at a time
query I
WITH RECURSIVE steps(i, state, alarms) AS (
    SELECT 0, cpt_online_new(), []::STRUCT(change_at BIGINT, detected_at BIGINT, shift DOUBLE, statistic DOUBLE)[]
    UNION ALL
    SELECT i + 1, r.state, list_concat(alarms, r.alarms)
    FROM steps, s, LATERAL (SELECT cpt_online_update(state, [xs[i + 1]]) AS r)
    WHERE i < 2000
)
SELECT alarms = (SELECT cpt_online(xs) FROM s) FROM steps WHERE i = 2000
----
true

# --- streaming with a state table: a batch arrives, alarms are recorded, the state moves on -----

statement ok
CREATE TABLE detector AS SELECT 'a' AS sensor, cpt_online_new(15.0, 100) AS state;

statement ok
CREATE TABLE alarms (sensor VARCHAR, change_at BIGINT, detected_at BIGINT, shift DOUBLE, statistic DOUBLE);

statement ok
CREATE TABLE batches AS SELECT 1 AS batch, 'a' AS sensor, xs[1:1000] AS xs FROM s
UNION ALL SELECT 2, 'a', xs[1001:2000] FROM s;

statement ok
CREATE TEMP TABLE step AS
SELECT d.sensor, cpt_online_update(d.state, b.xs) AS r FROM detector d JOIN batches b USING (sensor) WHERE b.batch = 1;

statement ok
INSERT INTO alarms SELECT sensor, unnest(r.alarms, recursive := true) FROM step;

statement ok
UPDATE detector SET state = step.r.state FROM step WHERE detector.sensor = step.sensor;

statement ok
CREATE OR REPLACE TEMP TABLE step AS
SELECT d.sensor, cpt_online_update(d.state, b.xs) AS r FROM detector d JOIN batches b USING (sensor) WHERE b.batch = 2;

statement ok
INSERT INTO alarms SELECT sensor, unnest(r.alarms, recursive := true) FROM step;

statement ok
UPDATE detector SET state = step.r.state FROM step WHERE detector.sensor = step.sensor;

query III
SELECT sensor, change_at, detected_at FROM alarms ORDER BY detected_at
----
a	599	614
a	1400	1405

# --- a given baseline: every alarm restarts against the same baseline, so a shift that persists keeps
# alarming (here: the first alarm at the change, estimated at 599 for the true 600, then every few points
# while it lasts) ------------------------------------------------------------------------------------------

query II
SELECT len(alarms) > 10, alarms[1].change_at
FROM (SELECT cpt_online(xs, 15.0, 20.0, 2.0) AS alarms FROM s)
----
true	599

# --- parameters, NULLs and errors ---------------------------------------------------------------------

query III
SELECT octet_length(cpt_online_new()), octet_length(cpt_online_new(10.0, 50)), octet_length(cpt_online_new(10.0, 0.0, 1.0))
----
128	128	160

query IIII
SELECT cpt_online_update(cpt_online_new(), NULL), cpt_online(NULL::DOUBLE[]), cpt_online([]::DOUBLE[]),
       (cpt_online_update(cpt_online_new(), [1.0, 2.0])).training
----
NULL	NULL	[]	true

statement error
SELECT cpt_online_new(0.0)
----
threshold must be a finite number > 0, got 0

statement error
SELECT cpt_online_new(10.0, 1)
----
train must be 0 (baseline given) or >= 2, got 1

statement error
SELECT cpt_online_new(10.0, NULL, 1.0)
----
a given baseline needs both mean and sd

statement error
SELECT cpt_online_new(10.0, 0.0, 0.0)
----
a given baseline needs a finite mean and a finite sd > 0

statement error
SELECT cpt_online_update(NULL, [1.0])
----
state must not be NULL; create one with cpt_online_new()

statement error
SELECT cpt_online_update('garbage'::BLOB, [1.0])
----
invalid online detector state: create one with cpt_online_new()

statement error
SELECT cpt_online_update(cpt_online_new(), [1.0, NULL])
----
series contains a NULL at position 2

# the work limit applies to the detector too
statement ok
SET cpt_max_evaluations = 100;

statement error
SELECT cpt_online(xs) FROM s
----
cpt_online: work limit reached

statement ok
RESET cpt_max_evaluations;
