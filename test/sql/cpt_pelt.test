# name: test/sql/cpt_pelt.test
# description: PELT on synthetic piecewise series (mirrors ruptures.pw_constant / pw_normal)
# group: [cpt]

require cpt

# Every generator reseeds right before its CREATE so the series is deterministic. range(n) with n
# below one vector is generated by a single thread, and DuckDB 1.5.6 and 2.0 produce the same
# random() sequence. Normal noise uses Box-Muller.

# --- changing mean: 4 segments of 250, means 0 / 5 / -3 / 2, sigma 1 --------------------------

statement ok
SELECT setseed(0.42);

statement ok
CREATE TABLE mean4 AS
SELECT list((CASE WHEN i < 250 THEN 0 WHEN i < 500 THEN 5 WHEN i < 750 THEN -3 ELSE 2 END)
            + sqrt(-2 * ln(random())) * cos(2 * pi() * random()) ORDER BY i) AS xs
FROM range(1000) t(i);

query IIII
SELECT cpt_pelt(xs), cpt_pelt(xs, 'l2'), cpt_pelt(xs, 'l2', 'mbic'), cpt_pelt(xs, 'l1') FROM mean4
----
[250, 500, 750, 1000]	[250, 500, 750, 1000]	[250, 500, 750, 1000]	[250, 500, 750, 1000]

# 'normal' also models the mean
query I
SELECT cpt_pelt(xs, 'normal') FROM mean4
----
[250, 500, 750, 1000]

# BIC for l2 is (1 + 1) * ln(n); passing that value explicitly gives the same answer
query I
SELECT cpt_pelt(xs, 'l2', 2 * ln(1000)) = cpt_pelt(xs, 'l2', NULL) FROM mean4
----
true

# a tiny penalty over-segments, a huge one returns a single segment
query II
SELECT len(cpt_pelt(xs, 'l2', 0.1)) > 100, cpt_pelt(xs, 'l2', 1e9) FROM mean4
----
true	[1000]

# --- changing variance: sigma 1 / 4 / 1, segments of 300 -------------------------------------

statement ok
SELECT setseed(0.42);

statement ok
CREATE TABLE var3 AS
SELECT list((CASE WHEN i < 300 THEN 1 WHEN i < 600 THEN 4 ELSE 1 END)
            * sqrt(-2 * ln(random())) * cos(2 * pi() * random()) ORDER BY i) AS xs
FROM range(900) t(i);

query II
SELECT cpt_pelt(xs, 'normal'), cpt_pelt(xs, 'normal', 'mbic') FROM var3
----
[300, 599, 900]	[300, 599, 900]

# l2 cannot see a variance change at mean 0 and either misses it or over-segments
query I
SELECT cpt_pelt(xs, 'l2') <> [300, 600, 900] FROM var3
----
true

# --- Poisson counts: rates 2 / 10 / 4, segments of 200 (inverse-CDF sampling) -----------------

statement ok
SELECT setseed(0.42);

statement ok
CREATE TABLE pois AS
WITH u AS (
    SELECT i, CASE WHEN i < 200 THEN 2 WHEN i < 400 THEN 10 ELSE 4 END AS lam, random() AS u
    FROM range(600) t(i)
)
SELECT list(len(list_filter(range(0, 60),
        lambda k: list_sum(list_transform(range(0, k + 1),
                  lambda j: exp(-lam + j * ln(lam) - lgamma(j + 1)))) < u)) ORDER BY i) AS xs
FROM u;

query II
SELECT cpt_pelt(xs, 'poisson'), cpt_pelt(xs, 'poisson', 'mbic') FROM pois
----
[200, 399, 600]	[200, 399, 600]

# --- 5% outliers of magnitude 50: l1 is robust once outliers cannot form their own segment -----

statement ok
SELECT setseed(0.42);

statement ok
CREATE TABLE outl AS
WITH u AS (
    SELECT i,
           (CASE WHEN i < 300 THEN 0 WHEN i < 600 THEN 3 ELSE 0 END)
           + 0.5 * sqrt(-2 * ln(random())) * cos(2 * pi() * random()) AS v,
           random() < 0.05 AS outlier
    FROM range(900) t(i)
)
SELECT list(v + CASE WHEN outlier THEN 50 ELSE 0 END ORDER BY i) AS xs FROM u;

query II
SELECT cpt_pelt(xs, 'l1', NULL, 10), len(cpt_pelt(xs, 'l2', NULL, 10)) > 10 FROM outl
----
[300, 600, 900]	true

# --- min_size --------------------------------------------------------------------------------

# a 2-point blip is its own segment with min_size 1; with min_size 3 it is widened to the
# 3-point segment [0, 9, 9] (SS 54 + 2 * 1.0 beats SS 135 for no split); with 6 the only
# split (at 6) costs 67.5 + 67.5 + 1.0 > 135, so the blip is absorbed
query III
SELECT cpt_pelt(xs, 'l2', 1.0, 1), cpt_pelt(xs, 'l2', 1.0, 3), cpt_pelt(xs, 'l2', 1.0, 6)
FROM (SELECT [0, 0, 0, 0, 0, 9, 9, 0, 0, 0, 0, 0]::DOUBLE[] AS xs)
----
[5, 7, 12]	[4, 7, 12]	[12]

# no segment is ever shorter than min_size
query I
SELECT bool_and(list_min(list_transform(range(1, len(b) + 1),
                lambda k: b[k] - coalesce(b[k - 1], 0))) >= m)
FROM mean4, (SELECT unnest([1, 2, 5, 17, 40]) AS m), LATERAL (SELECT cpt_pelt(xs, 'l2', 0.5, m) AS b)
----
true

# 'normal' needs two points per segment even when min_size is 1
query I
SELECT list_min(list_transform(range(1, len(b) + 1), lambda k: b[k] - coalesce(b[k - 1], 0)))
FROM (SELECT cpt_pelt([0, 0, 5, 5, 0, 0, 7, 1, 3, 2, 9, 4]::DOUBLE[], 'normal', 0.0, 1) AS b)
----
2

# --- GROUP BY: one series per sensor -----------------------------------------------------------

statement ok
CREATE TABLE readings AS
SELECT sensor_id,
       TIMESTAMP '2026-01-01' + to_minutes(i) AS ts,
       (CASE WHEN i < cp THEN 0.0 ELSE 4.0 END) + 0.3 * sin(i * 1.7 + sensor_id) AS value
FROM (VALUES (1, 40), (2, 75), (3, 120)) s(sensor_id, cp), range(160) t(i);

query II
SELECT sensor_id, cpt_pelt(list(value ORDER BY ts), 'l2') AS bkps
FROM readings GROUP BY sensor_id ORDER BY sensor_id
----
1	[40, 160]
2	[75, 160]
3	[120, 160]

query II
SELECT sensor_id, cpt_pelt(list(value ORDER BY ts), 'normal', NULL, 5) AS bkps
FROM readings GROUP BY sensor_id ORDER BY sensor_id
----
1	[40, 160]
2	[75, 160]
3	[120, 160]

# rows arrive in any order; ORDER BY inside list() fixes the series
query I
SELECT count(DISTINCT bkps) FROM (
    SELECT cpt_pelt(list(value ORDER BY ts), 'l2') AS bkps
    FROM (SELECT * FROM readings WHERE sensor_id = 2 ORDER BY random())
    UNION ALL
    SELECT cpt_pelt(list(value ORDER BY ts), 'l2') FROM readings WHERE sensor_id = 2
)
----
1
